<Window x:Class="SteamProcessIdler.AddCustomGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Custom Game"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="440"
        Height="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#171A21"
        Foreground="#E5ECEE"
        FontFamily="Segoe UI"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1B2838" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2A475E" />
        <SolidColorBrush x:Key="AccentBrush" Color="#66C0F4" />
        <SolidColorBrush x:Key="InputBgBrush" Color="#0E141D" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8F98A0" />

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBgBrush}" />
            <Setter Property="Foreground" Value="#E5ECEE" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B779A" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Opacity" Value="0.6" />
                                <Setter TargetName="border" Property="Background" Value="#090D14" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#5C7E10" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#749F13" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#49640D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#212C3D" />
            <Setter Property="Foreground" Value="#C6D4DF" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2D3E56" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#17202D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="HeaderTitleText" Text="Add Custom Game" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
            <TextBlock x:Name="HeaderSubtitleText" Text="Enter the Steam AppID and executable parameters."
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Steam AppID *" FontWeight="SemiBold" FontSize="12" Foreground="#C6D4DF" Margin="0,0,0,4" />
                <TextBox x:Name="AppIdTextBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,12" ToolTip="Numeric Steam Application ID (e.g., 480)" />

                <TextBlock Text="Game Title *" FontWeight="SemiBold" FontSize="12" Foreground="#C6D4DF" Margin="0,0,0,4" />
                <TextBox x:Name="GameNameTextBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,12" ToolTip="Display title in library list" />

                <TextBlock Text="Install Directory (Optional)" FontWeight="SemiBold" FontSize="12" Foreground="#C6D4DF" Margin="0,0,0,4" />
                <TextBox x:Name="InstallDirTextBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,12" ToolTip="Installation directory name (e.g., Spacewar or Counter-Strike Global Offensive)" />

                <TextBlock Text="Executable File (.exe) *" FontWeight="SemiBold" FontSize="12" Foreground="#C6D4DF" Margin="0,0,0,4" />
                <TextBox x:Name="ExecutableTextBox" Style="{StaticResource FormTextBoxStyle}" Margin="0,0,0,4" ToolTip="Executable filename or relative path (e.g., cs2.exe or bin\win64\game.exe)" />
                <TextBlock Text="Relative path (e.g., game.exe or bin\win64\game.exe)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />

                <TextBlock x:Name="ErrorTextBlock" Foreground="#FF6B6B" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click" Margin="0,0,10,0" Width="90" />
            <Button x:Name="SaveButton" Content="Add Game" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" Width="115" />
        </StackPanel>
    </Grid>
</Window>
